# Python
__pycache__/
*.pyc

# Brainstorming companion screens + SDD workspaces
.superpowers/

# Console local state: venv (self-ignores via its own .gitignore) and run transcripts
.claude/console/

# Console frontend build inputs. NOTE: scripts/console/dist/ is deliberately NOT
# ignored — the built bundle is committed so installing users need no Node.
console-ui/node_modules/
console-ui/.vite/
console-ui/*.tsbuildinfo
.playwright-mcp/
.claude/agents-board.jsonl

# Linked worktrees (EnterWorktree / git worktree add)
.claude/worktrees/

# Per-agent scratch memory written by subagents mid-run. Local like the rest of
# .claude/ runtime state: nothing prunes it, so in git it would accumulate and go
# stale. Findings worth keeping become artifacts under docs/ instead.
.claude/agent-memory/